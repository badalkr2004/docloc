# ─── Database (Neon PostgreSQL) ───
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/docloc?sslmode=require

# ─── Redis (for BullMQ job queue) ───
REDIS_URL=redis://localhost:6379

# ─── Cloudflare R2 Storage ───
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=docloc-vault

# ─── Better-Auth ───
BETTER_AUTH_SECRET=generate_a_32_char_random_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ─── App Config ───
PORT=8000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Email (Resend) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@docloc.app
